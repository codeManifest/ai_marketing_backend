// schema.prisma
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@map("accounts")
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("sessions")
}

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String    @unique
  password      String?
  emailVerified DateTime?
  image         String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  // Account-level subscription
  subscriptionId String?

  // Moderation & Suspension
  status          UserStatus @default(ACTIVE)
  statusReason    String?    @db.Text
  statusUpdatedAt DateTime?
  statusUpdatedBy String?

  // Relations
  accounts            Account[]
  sessions            Session[]
  memberships         Membership[]
  AuditLog            AuditLog[]
  Invitation          Invitation[]
  subscriptions       Subscription[]
  AIUsage             AIUsage[]
  payments            Payment[]
  SubscriptionHistory SubscriptionHistory[]
  ownedWorkspaces     Workspace[]           @relation("WorkspaceOwner") // User's owned workspaces
  Post                Post[]
  systemRoles         UserSystemRole[]

  @@map("users")
}

enum InvitationStatus {
  PENDING
  ACCEPTED
  EXPIRED
  REVOKED
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
  @@map("verification_tokens")
}

// User invitation system
model Invitation {
  id          String           @id @default(cuid())
  workspaceId String
  email       String
  role        UserRole
  token       String           @unique
  invitedBy   String // userId
  status      InvitationStatus @default(PENDING)
  expiresAt   DateTime
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  // Relations
  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  user      User?     @relation(fields: [invitedBy], references: [id])

  @@unique([workspaceId, email])
  @@index([token])
  @@map("invitations")
}

// Multi-tenant workspace for each brand/business
model Workspace {
  id          String   @id @default(cuid())
  name        String
  description String?  @db.Text
  slug        String   @unique
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  isActive    Boolean  @default(true)
  settings    Json?

  // Owner reference (user who created this workspace)
  ownerId String

  // Subscription reference (which subscription this workspace belongs to)
  subscriptionId String?

  status workspace_status @default(ACTIVE)

  // Brand details
  brandName   String
  brandpdfUrl String?
  industry    String?
  website     String?
  timezone    String  @default("UTC")

  // Moderation & Suspension details
  statusReason    String?   @db.Text
  statusUpdatedAt DateTime?
  statusUpdatedBy String?

  // Relations
  owner              User                 @relation("WorkspaceOwner", fields: [ownerId], references: [id], onDelete: Cascade)
  subscription       Subscription?        @relation(fields: [subscriptionId], references: [id], onDelete: SetNull)
  limitUsage         WorkspaceLimitUsage?
  AuditLog           AuditLog[]
  memberships        Membership[]
  socialProfiles     SocialProfile[]
  posts              Post[]
  tasks              Task[]
  AISettings         AISettings[]
  Replies            Reply[]
  Payment            Payment[]
  Invitation         Invitation[]
  AIUsage            AIUsage[]
  ContentCategory    ContentCategory[]
  AIPrompt           AIPrompt[]
  PostTemplate       PostTemplate[]
  ContentPlan        ContentPlan[]
  GeneratedPost      GeneratedPost[]
  BulkContentSession BulkContentSession[]
  ContentCalendar    ContentCalendar[]
  workspaceAnalytics WorkspaceAnalytic[]
  adCampaigns        AdCampaign[]
  leads              Lead[]
  socialCredentials  SocialCredential[]
  notifications      Notification[]
  brandProfile       BrandProfile?
  customRoles        WorkspaceRole[]
  verifiedDomains    VerifiedDomain[]
  customForms        CustomForm[]
  conversionFunnels  ConversionFunnel[]

  @@map("workspaces")
}

// Payment model for tracking transactions (account-level)
model Payment {
  id             String        @id @default(cuid())
  userId         String // Account owner
  subscriptionId String? // For subscription payments
  workspaceId    String? // Optional - for workspace-specific payments
  planId         String
  amount         Float
  currency       String        @default("INR")
  status         PaymentStatus @default(PENDING_PAYMENT)

  // Razorpay fields
  razorpayPaymentId String?
  razorpayOrderId   String?
  razorpaySignature String?

  // Timestamps
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  completedAt DateTime?

  // Error handling
  errorMessage String?
  retryCount   Int     @default(0)

  // Metadata
  metadata Json?

  // Relations
  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  subscription Subscription? @relation(fields: [subscriptionId], references: [id])
  workspace    Workspace?    @relation(fields: [workspaceId], references: [id])
  plan         Plan          @relation(fields: [planId], references: [id])

  @@index([userId])
  @@index([subscriptionId])
  @@index([status])
  @@index([createdAt])
  @@map("payments")
}

// User membership in workspaces with roles
model Membership {
  id          String   @id @default(cuid())
  userId      String
  workspaceId String
  role        UserRole @default(MEMBER)
  joinedAt    DateTime @default(now())
  invitedBy   String?

  // Relations
  memberRoles       MembershipRole[]
  directPermissions MembershipPermission[]
  user              User                   @relation(fields: [userId], references: [id], onDelete: Cascade)
  workspace         Workspace              @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@unique([userId, workspaceId])
  @@map("memberships")
}

// Connected social media profiles
model SocialProfile {
  id          String         @id @default(cuid())
  workspaceId String
  platform    SocialPlatform
  platformId  String // Facebook Page ID same:externalId,
  avatar      String?
  name        String
  username    String?
  email       String?

  accessToken    String?   @db.Text
  refreshToken   String?   @db.Text
  tokenExpiresAt DateTime?
  isConnected    Boolean   @default(true)
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  // Platform-specific data
  profilePicture String?
  followersCount Int?
  likesCount     Int?
  lastSynced     DateTime?

  // Settings
  autoRespond Boolean @default(false)
  autoPost    Boolean @default(false)

  // Relations
  workspace     Workspace         @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  posts         Post[]
  replies       Reply[]
  analytics     SocialAnalytics[]
  GeneratedPost GeneratedPost[]

  @@unique([workspaceId, platform, platformId])
  @@map("social_profiles")
}

// Content posts for social media
model Post {
  id              String         @id @default(cuid())
  workspaceId     String
  socialProfileId String
  content         String         @db.Text
  mediaUrls       Json? // JSON array of image/video URLs
  hashtags        String?        @db.Text
  scheduledFor    DateTime? // null for immediate posting
  postedAt        DateTime? // null if not posted yet
  status          PostStatus     @default(DRAFT)
  platform        SocialPlatform
  bulkId          String?
  bulkTitle       String?
  postId          String? // Platform's post ID after publishing
  aiGenerated     Boolean        @default(false)
  aiPrompt        String?        @db.Text
  engagementRate  Float?         @default(0)
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt
  userId          String?

  // Relations
  user          User?           @relation(fields: [userId], references: [id])
  workspace     Workspace       @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  socialProfile SocialProfile   @relation(fields: [socialProfileId], references: [id], onDelete: Cascade)
  analytics     PostAnalytics[]
  comments      Comment[]
  GeneratedPost GeneratedPost[]

  @@map("posts")
}

// AI-generated replies for reviews and comments
model Reply {
  id              String         @id @default(cuid())
  workspaceId     String
  socialProfileId String
  originalMessage String         @db.Text
  aiReply         String         @db.Text
  sentiment       Sentiment?
  category        ReplyCategory
  status          ReplyStatus    @default(PENDING)
  platform        SocialPlatform
  platformPostId  String? // ID of the post being replied to
  platformUserId  String? // ID of the user being replied to
  sentAt          DateTime?
  createdAt       DateTime       @default(now())

  // Relations
  workspace     Workspace     @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  socialProfile SocialProfile @relation(fields: [socialProfileId], references: [id], onDelete: Cascade)

  @@map("replies")
}

// Task management within workspaces
model Task {
  id          String     @id @default(cuid())
  workspaceId String
  title       String
  description String?    @db.Text
  status      TaskStatus @default(PENDING)
  priority    Priority   @default(MEDIUM)
  dueDate     DateTime?
  assignedTo  String? // userId
  completedAt DateTime?
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  // Relations
  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@map("tasks")
}

// Analytics data for social profiles
model SocialAnalytics {
  id              String   @id @default(cuid())
  socialProfileId String
  date            DateTime
  impressions     Int      @default(0)
  engagements     Int      @default(0)
  likes           Int      @default(0)
  comments        Int      @default(0)
  shares          Int      @default(0)
  followers       Int      @default(0)
  reach           Int      @default(0)
  createdAt       DateTime @default(now())

  // Relations
  socialProfile SocialProfile @relation(fields: [socialProfileId], references: [id], onDelete: Cascade)

  @@unique([socialProfileId, date])
  @@map("social_analytics")
}

// Post-level analytics
model PostAnalytics {
  id          String   @id @default(cuid())
  postId      String
  date        DateTime
  impressions Int      @default(0)
  engagements Int      @default(0)
  likes       Int      @default(0)
  comments    Int      @default(0)
  shares      Int      @default(0)
  clicks      Int      @default(0)
  createdAt   DateTime @default(now())

  // Relations
  post Post @relation(fields: [postId], references: [id], onDelete: Cascade)

  @@unique([postId, date])
  @@map("post_analytics")
}

// Comments on posts
model Comment {
  id         String     @id @default(cuid())
  postId     String
  platformId String // Comment ID from the social platform
  authorName String
  authorId   String?
  content    String     @db.Text
  sentiment  Sentiment?
  replied    Boolean    @default(false)
  createdAt  DateTime
  fetchedAt  DateTime   @default(now())

  // Relations
  post Post @relation(fields: [postId], references: [id], onDelete: Cascade)

  @@unique([postId, platformId])
  @@map("comments")
}

// Account-level subscription plans
model Plan {
  id                String       @id @default(cuid())
  name              String       @unique
  price             Decimal
  maxWorkspaces     Int          @default(1)
  monthlyAiCredits  Int          @default(100)
  maxSocialProfiles Int          @default(5)
  currency          String       @default("INR")
  isTrial           Boolean      @default(false)
  billingCycle      BillingCycle @default(MONTHLY)
  features          Json
  isActive          Boolean      @default(true)

  // Granular Feature Flags
  includeSeoTool         Boolean @default(false)
  allowedVideos          Boolean @default(false)
  allowedGraphics        Boolean @default(false)
  includeAdManager       Boolean @default(false)
  includeLeadsCRM        Boolean @default(false)
  includeAnalytics       Boolean @default(false)
  includeAiContentStudio Boolean @default(false)
  includeAutomation      Boolean @default(false)
  includeWebsiteManager  Boolean @default(false)

  // AI Engine Models Assignment
  includeTextModel     AIModel @default(GEMINI_2_5_FLASH)
  includeGraphicsModel AIModel @default(IMAGEN_3)
  includeVideoModel    AIModel @default(VEO)

  // Capacity and Generation Limits (-1 for unlimited)
  maxAiAutoReplies  Int @default(50)
  maxPostsGenerated Int @default(100)
  maxAiTemplates    Int @default(5)
  maxCategories     Int @default(10)
  maxAiPrompts      Int @default(10)
  maxInboxReplies   Int @default(500)
  annualDiscount    Int @default(0) // Discount percentage for annual plans (0 to 80)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  subscriptions Subscription[]
  payments      Payment[]

  @@map("plans")
}

// Account-level subscriptions
model Subscription {
  id      String             @id @default(cuid())
  userId  String // Account owner
  planId  String
  status  SubscriptionStatus @default(ACTIVE)
  isTrial Boolean            @default(false)

  // Razorpay fields
  razorpaySubscriptionId String?
  razorpayCustomerId     String?
  razorpayOrderId        String?

  // Billing period
  currentPeriodStart DateTime?
  currentPeriodEnd   DateTime?
  cancelAtPeriodEnd  Boolean   @default(false)

  // Usage tracking
  usedWorkspaces Int @default(0)
  usedAiCredits  Int @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  user       User                  @relation(fields: [userId], references: [id], onDelete: Cascade)
  plan       Plan                  @relation(fields: [planId], references: [id])
  workspaces Workspace[] // All workspaces under this subscription
  payments   Payment[]
  history    SubscriptionHistory[]
  AIUsage    AIUsage[]

  @@unique([userId, status], map: "active_subscription_per_user") // Only one active subscription per user
  @@index([status])
  @@index([currentPeriodEnd])
  @@map("subscriptions")
}

model SubscriptionHistory {
  id             String   @id @default(cuid())
  subscriptionId String
  userId         String
  oldPlanId      String?
  newPlanId      String
  changeDate     DateTime @default(now())
  reason         String? // upgrade/downgrade/cancellation

  // Relations
  subscription Subscription @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("subscription_history")
}

// AI model settings and usage tracking
model AISettings {
  id          String    @id @default(cuid())
  workspaceId String
  model       String    @default("gpt-4")
  maxTokens   Int       @default(500)
  temperature Float     @default(0.7)
  usageCount  Int       @default(0)
  lastUsed    DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  // Relations
  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@unique([workspaceId])
  @@map("ai_settings")
}

// AI Usage tracking
model AIUsage {
  id             String   @id @default(cuid())
  userId         String
  workspaceId    String?
  subscriptionId String?
  feature        String // "content_generation", "sentiment_analysis", "reply_generation"
  provider       String?
  model          String?
  metadata       Json?
  details        Json?
  creditsUsed    Int
  inputTokens    Int?
  outputTokens   Int?
  cost           Decimal? // Cost incurred for this usage
  createdAt      DateTime @default(now())

  // Relations
  user         User          @relation(fields: [userId], references: [id])
  workspace    Workspace?    @relation(fields: [workspaceId], references: [id])
  subscription Subscription? @relation(fields: [subscriptionId], references: [id])

  @@index([userId])
  @@index([workspaceId])
  @@index([createdAt])
  @@map("ai_usage")
}

model AuditLog {
  id          String   @id @default(cuid())
  workspaceId String?
  userId      String
  action      String
  resource    String
  resourceId  String?
  details     Json?
  ipAddress   String?
  userAgent   String?
  createdAt   DateTime @default(now())

  // Relations
  workspace Workspace? @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  user      User       @relation(fields: [userId], references: [id])

  @@index([workspaceId])
  @@index([userId])
  @@index([createdAt])
  @@map("audit_logs")
}

// Enums
enum UserRole {
  SUPER_ADMIN
  OWNER
  ADMIN
  MANAGER
  SUPPORT
  CONTENT_CREATOR
  ANALYST
  VIEWER
  MEMBER
}

enum SocialPlatform {
  FACEBOOK
  INSTAGRAM
  LINKEDIN
  GOOGLE_MY_BUSINESS
  TWITTER
  TIKTOK
  PINTEREST
  YOUTUBE
}

enum PostStatus {
  DRAFT
  SCHEDULED
  POSTING
  PENDING

  POSTED
  FAILED
  CANCELLED
}

enum ReplyStatus {
  PENDING
  APPROVED
  SENT
  REJECTED
  FAILED
}

enum ReplyCategory {
  REVIEW
  COMMENT
  MESSAGE
  MENTION
}

enum Sentiment {
  POSITIVE
  NEUTRAL
  NEGATIVE
}

enum TaskStatus {
  PENDING
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

enum Priority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

enum SubscriptionStatus {
  ACTIVE
  CANCELLED
  PAST_DUE
  TRIAL
  INCOMPLETE
  PENDING
  EXPIRED
}

enum PaymentStatus {
  PENDING_PAYMENT
  PAID_PAYMENT
  FAILED_PAYMENT
  REFUND_PAYMENT
  PARTIALLY_REFUNDED
}

enum workspace_status {
  ACTIVE
  SUSPENDED
  DEACTIVE
}

enum BillingCycle {
  MONTHLY
  YEARLY
  LIFETIME
}

// new models

// Add these new models to your existing schema

// Content Categories and Templates
model ContentCategory {
  id          String   @id @default(cuid())
  workspaceId String
  name        String
  description String?
  color       String? // For UI display
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // Relations
  workspace     Workspace      @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  contentPlans  ContentPlan[]
  aiPrompts     AIPrompt[]
  postTemplates PostTemplate[]

  @@map("content_categories")
}

// AI Prompts for different content types
model AIPrompt {
  id            String   @id @default(cuid())
  workspaceId   String
  categoryId    String
  name          String
  prompt        String   @db.Text
  description   String?
  exampleOutput String?  @db.Text
  isActive      Boolean  @default(true)
  temperature   Float    @default(0.7)
  maxTokens     Int      @default(1000)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  // Relations
  workspace    Workspace       @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  category     ContentCategory @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  contentPlans ContentPlan[]

  @@map("ai_prompts")
}

// Post Templates for consistent formatting
model PostTemplate {
  id          String   @id @default(cuid())
  workspaceId String
  categoryId  String
  name        String
  template    String   @db.Text
  description String?
  variables   Json? // Define template variables like {topic}, {hashtags}, etc.
  example     String?  @db.Text
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // Relations
  workspace    Workspace       @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  category     ContentCategory @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  contentPlans ContentPlan[]

  @@map("post_templates")
}

// Content Planning - Main model for automated scheduling
model ContentPlan {
  id          String  @id @default(cuid())
  workspaceId String
  categoryId  String
  promptId    String?
  templateId  String?
  name        String
  description String?

  // Content settings
  topics   String  @db.Text // Comma-separated topics or JSON array
  tone     String? // Professional, Casual, Funny, etc.
  language String  @default("en")

  // Scheduling configuration
  frequency      ScheduleFrequency
  postsPerWeek   Int               @default(1)
  preferredDays  Json? // Preferred days of week [1,3,5] where 1=Monday
  preferredTimes Json? // Preferred times ["09:00", "14:00", "18:00"]
  timezone       String            @default("UTC")

  // Platform targeting
  platforms Json // Array of SocialPlatform values

  // Social profiles to post to
  socialProfileIds Json? // Array of social profile IDs

  // Content generation settings
  autoGenerate     Boolean @default(true)
  requireApproval  Boolean @default(false)
  autoPost         Boolean @default(false)
  generateGraphics Boolean @default(true)
  generateVideos   Boolean @default(true)
  budget           Float   @default(0)
  objective        String  @default("Conversions")

  // Status
  status          PlanStatus @default(ACTIVE)
  lastGeneratedAt DateTime?

  // Limits and tracking
  maxPostsPerMonth Int?
  postsGenerated   Int  @default(0)
  postsPosted      Int  @default(0)

  // Generation Progress & State
  isGenerating      Boolean  @default(false)
  genPostsTotal     Int      @default(0)
  genPostsCompleted Int      @default(0)
  genMediaTotal     Int      @default(0)
  genMediaCompleted Int      @default(0)
  generationPaused  Boolean  @default(false)
  generationAborted Boolean  @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  workspace      Workspace       @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  category       ContentCategory @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  prompt         AIPrompt?       @relation(fields: [promptId], references: [id])
  template       PostTemplate?   @relation(fields: [templateId], references: [id])
  generatedPosts GeneratedPost[]

  @@map("content_plans")
}

// Generated posts from content plans
model GeneratedPost {
  id              String  @id @default(cuid())
  contentPlanId   String
  workspaceId     String
  socialProfileId String?

  // Content
  title     String?
  content   String  @db.Text
  mediaUrls Json? // JSON array of image/video URLs
  hashtags  String? @db.Text
  topics    Json? // Topics used for generation

  // Scheduling
  scheduledFor DateTime?
  postedAt     DateTime?

  // Status
  status GeneratedPostStatus @default(DRAFT)

  // AI Generation info
  aiPrompt         String? @db.Text
  aiModel          String?
  promptTokens     Int?
  completionTokens Int?
  brandContextUsed Boolean @default(false)
  brandContext     String? @db.Text

  // Approval workflow
  requiresApproval Boolean   @default(false)
  approvedBy       String? // userId
  approvedAt       DateTime?
  rejectionReason  String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  contentPlan   ContentPlan    @relation(fields: [contentPlanId], references: [id], onDelete: Cascade)
  workspace     Workspace      @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  socialProfile SocialProfile? @relation(fields: [socialProfileId], references: [id])
  post          Post?          @relation(fields: [postId], references: [id])

  // Link to actual posted post
  postId String?

  @@map("generated_posts")
}

// Bulk content generation sessions
model BulkContentSession {
  id          String  @id @default(cuid())
  workspaceId String
  name        String
  description String?

  // Configuration
  categories    Json? // Array of category IDs
  totalPosts    Int
  timeframeDays Int // Generate posts for next X days
  platforms     Json // Target platforms

  // Status
  status         BulkSessionStatus @default(PENDING)
  progress       Float             @default(0) // 0-100
  postsGenerated Int               @default(0)

  // Results
  generatedPosts Json? // Array of generated post IDs

  startedAt   DateTime?
  completedAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  // Relations
  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@map("bulk_content_sessions")
}

// Content Calendar for visualization
model ContentCalendar {
  id          String   @id @default(cuid())
  workspaceId String
  date        DateTime
  posts       Json? // Array of posts scheduled for this date
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // Relations
  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@unique([workspaceId, date])
  @@map("content_calendar")
}

// Add these enums to your existing enums

enum ScheduleFrequency {
  DAILY
  WEEKLY
  MONTHLY
  CUSTOM
}

enum PlanStatus {
  ACTIVE
  PAUSED
  COMPLETED
  CANCELLED
}

enum GeneratedPostStatus {
  DRAFT
  GENERATED
  APPROVED
  REJECTED
  SCHEDULED
  POSTED
  FAILED
}

enum BulkSessionStatus {
  PENDING
  GENERATING
  COMPLETED
  FAILED
  CANCELLED
}

// WorkspaceAnalytics model for snapshot caching
model WorkspaceAnalytic {
  id          String   @id @default(cuid())
  workspaceId String
  date        DateTime @default(now())

  // Daily overall metrics
  impressions Int   @default(0)
  clicks      Int   @default(0)
  conversions Int   @default(0)
  revenue     Float @default(0)
  cost        Float @default(0)

  // Channel breakdown clicks
  facebookClicks  Int @default(0)
  instagramClicks Int @default(0)
  linkedinClicks  Int @default(0)
  tiktokClicks    Int @default(0)
  googleClicks    Int @default(0)
  otherClicks     Int @default(0)

  // Funnel steps counts
  funnelImpressions  Int @default(0)
  funnelClicks       Int @default(0)
  funnelLandingViews Int @default(0)
  funnelLeads        Int @default(0)
  funnelConversions  Int @default(0)

  // Device breakdown clicks
  mobileClicks  Int @default(0)
  desktopClicks Int @default(0)
  tabletClicks  Int @default(0)

  // JSON breakdown structures
  geographic   Json? // e.g. { "US": 28.6, "IN": 18.3, ... }
  demographics Json? // e.g. { "age": { "18-24": 18, ... }, "gender": { "male": 58, "female": 42 } }

  // Relations
  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@unique([workspaceId, date])
  @@map("workspace_analytics")
}

// Ad Campaign model for tracking ads across platforms
model AdCampaign {
  id          String   @id @default(cuid())
  workspaceId String
  name        String
  platform    String // meta, google, linkedin, tiktok
  status      String // Active, Paused, Draft
  budget      String
  spend       Float    @default(0)
  impressions Int      @default(0)
  clicks      Int      @default(0)
  ctr         String   @default("0%")
  conversions Int      @default(0)
  cpa         Float    @default(0)
  roas        String   @default("—")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // Relations
  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@map("ad_campaigns")
}

model Lead {
  id          String   @id @default(cuid())
  workspaceId String
  name        String
  email       String
  phone       String?
  company     String?
  title       String?
  status      String   @default("New") // New, Contacted, Qualified, Converted, Lost
  score       Int      @default(50)
  source      String   @default("Website")
  ownerName   String?
  ownerAvatar String?
  location    String?
  campaign    String?
