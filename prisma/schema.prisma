// Workspace Limit and Usage Tracker for counter queries optimization
model WorkspaceLimitUsage {
  id              String    @id @default(cuid())
  workspaceId     String    @unique
  categoriesCount Int       @default(0)
  templatesCount  Int       @default(0)
  postsCount      Int       @default(0)
  repliesCount    Int       @default(0)
  promptsCount    Int       @default(0)
  
  workspace       Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  @@map("workspace_limit_usages")
}

// AI credit consumption costing rules configuration
model AICreditCost {
  id          String       @id @default(cuid())
  action      CreditAction @unique
  cost        Int          @default(1) // Credits required for this action
  description String?      @db.Text
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  @@map("ai_credit_costs")
}

// System-wide Global Templates with optimized system prompts for all users
model GlobalTemplate {
  id          String   @id @default(cuid())
  name        String   @unique
  slug        String   @unique // e.g., "blog-post", "ad-copy", "content-rewriter"
  title       String
  description String?  @db.Text
  prompt      String   @db.Text // Engineered prompt template with variables like {topic}, {keywords}
  category    String   // e.g., "Popular Templates", "Blog", "Ad Copy", "Writing Tools"
  icon        String?  // Lucide icon identifier string (e.g. "FileText", "Sparkles")
  variables   Json?    // Array of variable definition objects [{name: "topic", label: "Topic", placeholder: "..."}]
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("global_templates")
}

