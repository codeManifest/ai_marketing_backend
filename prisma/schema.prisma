// ==========================================
// 🛡️ MULTI-TENANT RBAC, PBAC & MODERATION
// ==========================================

enum UserStatus {
  ACTIVE
  SUSPENDED
  BANNED
}

// SaaS System-Level Administrator Roles (Platform Owners / Operators)
model SystemRole {
  id          String   @id @default(cuid())
  name        String   @unique // e.g., "SUPER_ADMIN", "BILLING_MANAGER", "SUPPORT_LEAD"
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // Relations
  users       UserSystemRole[]
  permissions SystemRolePermission[]

  @@map("system_roles")
}

// SaaS System-Level Action Capabilities
model SystemPermission {
  id          String   @id @default(cuid())
  name        String   @unique // e.g., "system:users:read", "system:workspaces:delete", "system:billing:manage"
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // Relations
  roles SystemRolePermission[]

  @@map("system_permissions")
}

// Junction table linking system roles to system permissions
model SystemRolePermission {
  roleId       String
  permissionId String

  // Relations
  role       SystemRole       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission SystemPermission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
  @@map("system_role_permissions")
}

// Junction table assigning users to system administrator roles
model UserSystemRole {
  userId String
  roleId String

  // Relations
  user User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  role SystemRole @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@id([userId, roleId])
  @@map("user_system_roles")
}

// Predefined or custom tenant workspace roles
model WorkspaceRole {
  id               String   @id @default(cuid())
  workspaceId      String
  name             String // e.g., "Editor", "Designer", "Admin"
  description      String?
  isSystemTemplate Boolean  @default(false)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  // Relations
  workspace   Workspace                 @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  members     MembershipRole[]
  permissions WorkspaceRolePermission[]

  @@unique([workspaceId, name])
  @@map("workspace_roles")
}

// Predefined tenant workspace capabilities
model WorkspacePermission {
  id          String   @id @default(cuid())
  name        String   @unique // e.g., "posts:create", "social:connect", "billing:manage"
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // Relations
  roles       WorkspaceRolePermission[]
  memberships MembershipPermission[]

  @@map("workspace_permissions")
}

// Junction table linking workspace roles to workspace capabilities
model WorkspaceRolePermission {
  roleId       String
  permissionId String

  // Relations
  role       WorkspaceRole       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission WorkspacePermission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
  @@map("workspace_role_permissions")
}

// Junction table linking workspace members to roles
model MembershipRole {
  membershipId String
  roleId       String

  // Relations
  membership Membership    @relation(fields: [membershipId], references: [id], onDelete: Cascade)
  role       WorkspaceRole @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@id([membershipId, roleId])
  @@map("membership_roles")
}

// Direct tenant capability override table (direct PBAC assignment/override)
model MembershipPermission {
  membershipId String
  permissionId String
  allowed      Boolean @default(true)

  // Relations
  membership Membership          @relation(fields: [membershipId], references: [id], onDelete: Cascade)
  permission WorkspacePermission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([membershipId, permissionId])
  @@map("membership_permissions")
}

