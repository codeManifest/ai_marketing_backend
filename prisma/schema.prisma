}

model LeadNote {
  id        String   @id @default(cuid())
  leadId    String
  content   String   @db.Text
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  lead Lead @relation(fields: [leadId], references: [id], onDelete: Cascade)

  @@map("lead_notes")
}

model LeadTask {
  id        String   @id @default(cuid())
  leadId    String
  text      String
  done      Boolean  @default(false)
  createdAt DateTime @default(now())

  lead Lead @relation(fields: [leadId], references: [id], onDelete: Cascade)

  @@map("lead_tasks")
}

model LeadDeal {
  id        String   @id @default(cuid())
  leadId    String
  name      String
  value     String
  stage     String
  date      String
  createdAt DateTime @default(now())

  lead Lead @relation(fields: [leadId], references: [id], onDelete: Cascade)

  @@map("lead_deals")
}

model LeadActivity {
  id        String   @id @default(cuid())
  leadId    String
  time      String
  title     String
  desc      String
  createdAt DateTime @default(now())

  lead Lead @relation(fields: [leadId], references: [id], onDelete: Cascade)

  @@map("lead_activities")
}

model SocialCredential {
  id           String         @id @default(cuid())
  workspaceId  String
  platform     SocialPlatform
  clientId     String // App ID or Client ID
  clientSecret String         @db.Text // Encrypted App Secret or Client Secret
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt

  // Relations
  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@unique([workspaceId, platform])
  @@map("social_credentials")
}

model Notification {
  id          String   @id @default(cuid())
  workspaceId String
  userId      String?
  title       String
  message     String   @db.Text
  type        String   @default("info") // "info", "success", "warning", "error"
  read        Boolean  @default(false)
  link        String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // Relations
  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([workspaceId])
  @@index([read])
  @@map("notifications")
}

