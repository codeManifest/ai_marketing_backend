  provider     String   @unique // e.g., "GEMINI", "OPENAI", "REPLICATE", "OPENROUTER"
  apiKey       String   @db.Text
  baseUrl      String?  @db.Text
  defaultModel String?  @db.Text // e.g., "google/gemini-2.5-pro"
  settings     Json?    // For custom headers, site parameters etc.
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

