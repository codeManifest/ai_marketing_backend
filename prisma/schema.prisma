model VerifiedDomain {
  id                String              @id @default(cuid())
  workspaceId       String
  domain            String              // e.g. "mybusiness.com"
  verificationToken String              // e.g. "postly-verify-xyz789..."
  isVerified        Boolean             @default(false)
  verifiedAt        DateTime?
  createdAt         DateTime            @default(now())
  updatedAt         DateTime            @updatedAt

  // Floating Bubble Widget Configuration
  widgetActive      Boolean             @default(false)
  widgetWhatsApp    String?             // WhatsApp number, null/empty if disabled
  widgetPhone       String?             // Phone number, null/empty if disabled
  widgetMessage     String?             // Custom WhatsApp pre-filled message
  widgetPosition    String              @default("bottom-right") // "bottom-left" | "bottom-right"
  widgetColor       String              @default("#7c3aed") // Branding accent color
  
  workspace         Workspace           @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  blogPosts         BlogPost[]
  customForms       CustomForm[]
  analyticsEvents   WebAnalyticsEvent[]

  @@unique([workspaceId, domain])
  @@map("verified_domains")
}

model BlogPost {
  id            String         @id @default(cuid())
  domainId      String
  title         String
  slug          String
  content       String         @db.Text
  summary       String?        @db.Text
  featuredImage String?
  author        String?
  status        String         @default("DRAFT") // "DRAFT", "PUBLISHED"
  publishedAt   DateTime?
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  
  domain        VerifiedDomain @relation(fields: [domainId], references: [id], onDelete: Cascade)

  @@unique([domainId, slug])
  @@map("blog_posts")
}

model CustomForm {
  id               String           @id @default(cuid())
  workspaceId      String
  domainId         String?
  name             String
  fields           Json             // JSON array: [{id: "email", type: "email", label: "Email Address", required: true}]
  submitButtonText String           @default("Submit")
  successMessage   String           @default("Thank you for your submission!")
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt
  
  workspace        Workspace        @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  domain           VerifiedDomain?  @relation(fields: [domainId], references: [id], onDelete: SetNull)
  submissions      FormSubmission[]

  @@map("custom_forms")
}

model FormSubmission {
  id         String     @id @default(cuid())
  formId     String
  data       Json       // Form fields: {name: "John", email: "john@example.com"}
  userAgent  String?
  ipAddress  String?
  referrer   String?
  createdAt  DateTime   @default(now())
  
  form       CustomForm @relation(fields: [formId], references: [id], onDelete: Cascade)

  @@map("form_submissions")
}

model WebAnalyticsEvent {
  id         String         @id @default(cuid())
  domainId   String
  sessionId  String         // Maps multiple events to a single user visit
  eventType  String         // "PAGE_VIEW" | "CLICK" | "ENGAGEMENT"
  url        String         // Page URL path
  referrer   String?
  eventData  Json?          // { timeSpentSeconds: 45 } or { elementText: "Buy Now", elementId: "btn-pay" }
  deviceType String?        // "mobile" | "desktop" | "tablet"
  browser    String?
  country    String?
  
  // UTM Attribution columns
  utmSource   String?
  utmMedium   String?
  utmCampaign String?
  utmTerm     String?
  utmContent  String?
  
  // Identity Resolution columns
  anonId      String?
  leadId      String?
  
  createdAt  DateTime       @default(now())
  
  domain     VerifiedDomain @relation(fields: [domainId], references: [id], onDelete: Cascade)
  lead       Lead?          @relation(fields: [leadId], references: [id], onDelete: SetNull)

  @@map("web_analytics_events")
}

model ConversionFunnel {
  id          String   @id @default(cuid())
  workspaceId String
  name        String
  steps       Json     // Array of page paths: ["/", "/pricing", "/signup"]
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@map("conversion_funnels")
}



